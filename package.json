{
	"name": "@betfinio/luro",
	"private": true,
	"version": "1.0.0",
	"scripts": {
		"build": "rsbuild build",
		"check": "biome check --write",
		"format": "biome format --write",
		"preview": "rsbuild preview",
		"prebuild": "graphclient build",
		"dev": "bun run build:schema:dev && rsbuild dev --open",
		"prod": "bun run build:schema:prod && rsbuild dev --env-mode production --open",
		"local": "bun run build:schema:local && rsbuild dev --env-mode localhost --open",
		"build:schema:local": "dotenv -e .env.localhost.local -- graphclient build",
		"build:schema:dev": "dotenv -e .env.development.local -- graphclient build",
		"build:schema:prod": "dotenv -e .env.production.local -- graphclient build",
		"secret:dev": "bun run secret.ts -- development dev",
		"secret:prod": "bun run secret.ts -- production prod/bet"
	},
	"dependencies": {
		"@betfinio/abi": "^2.9.1",
		"@betfinio/components": "^2.7.1",
		"@lottiefiles/dotlottie-react": "^0.16.1",
		"@module-federation/enhanced": "^0.18.4",
		"@nivo/bar": "^0.99.0",
		"@nivo/pie": "^0.99.0",
		"@tailwindcss/postcss": "^4.1.13",
		"@tanstack/react-query": "5.66.10",
		"@tanstack/react-router": "1.131.37",
		"@tanstack/react-table": "8.21.3",
		"canvas-confetti": "^1.9.3",
		"consola": "^3.4.2",
		"i18next": "25.5.2",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-icu": "2.4.0",
		"intl-messageformat": "^10.7.16",
		"lucide-react": "^0.544.0",
		"luxon": "^3.7.2",
		"react": "19.1.0",
		"react-circular-progressbar": "^2.2.0",
		"react-dom": "19.1.0",
		"react-i18next": "15.7.3",
		"react-number-format": "^5.4.4",
		"react-virtualized": "^9.22.6",
		"tailwindcss": "^4.1.13",
		"viem": "2.33.3",
		"wagmi": "2.16.2"
	},
	"devDependencies": {
		"@aws-sdk/client-secrets-manager": "^3.887.0",
		"@biomejs/biome": "^2.2.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@graphprotocol/client-cli": "^3.0.7",
		"@module-federation/rsbuild-plugin": "^0.18.4",
		"@rsbuild/core": "^1.5.6",
		"@rsbuild/plugin-react": "^1.4.0",
		"@tanstack/router-plugin": "^1.131.41",
		"@types/animejs": "^3.1.13",
		"@types/bun": "^1.2.21",
		"@types/canvas-confetti": "^1.9.0",
		"@types/luxon": "^3.7.1",
		"@types/react": "^19.1.12",
		"@types/react-dom": "^19.1.9",
		"@types/react-virtualized": "^9.22.2",
		"dotenv-cli": "^10.0.0",
		"lefthook": "^1.13.0",
		"typescript": "^5.9.2"
	}
}
