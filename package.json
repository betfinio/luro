{
	"name": "@betfinio/luro",
	"private": true,
	"version": "1.0.0",
	"scripts": {
		"build": "rsbuild build",
		"check": "biome check --write",
		"format": "biome format --write",
		"preview": "rsbuild preview",
		"prebuild": "graphclient build",
		"dev": "bun run build:schema:dev && rsbuild dev --open",
		"prod": "bun run build:schema:prod && rsbuild dev --env-mode production --open",
		"local": "bun run build:schema:local && rsbuild dev --env-mode localhost --open",
		"build:schema:local": "dotenv -e .env.localhost.local -- graphclient build",
		"build:schema:dev": "dotenv -e .env.development.local -- graphclient build",
		"build:schema:prod": "dotenv -e .env.production.local -- graphclient build",
		"secret:dev": "bun run secret.ts -- development dev",
		"secret:prod": "bun run secret.ts -- production prod/io"
	},
	"dependencies": {
		"@betfinio/abi": "^2.9.0",
		"@betfinio/components": "^2.4.0-dev.4",
		"@lottiefiles/dotlottie-react": "^0.14.2",
		"@module-federation/enhanced": "^0.16.0",
		"@nivo/bar": "^0.99.0",
		"@nivo/pie": "^0.99.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@tanstack/react-query": "5.66.10",
		"@tanstack/react-router": "^1.124.0",
		"@tanstack/react-table": "^8.21.3",
		"canvas-confetti": "^1.9.3",
		"consola": "^3.4.2",
		"i18next": "^25.3.0",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-icu": "^2.3.0",
		"intl-messageformat": "^10.7.16",
		"lucide-react": "^0.525.0",
		"luxon": "^3.6.1",
		"react": "^19.1.0",
		"react-circular-progressbar": "^2.2.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^15.5.3",
		"react-number-format": "^5.4.4",
		"react-virtualized": "^9.22.6",
		"tailwindcss": "^4.1.11",
		"wagmi": "^2.15.6"
	},
	"devDependencies": {
		"@aws-sdk/client-secrets-manager": "^3.840.0",
		"@biomejs/biome": "^2.0.6",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@graphprotocol/client-cli": "^3.0.7",
		"@module-federation/rsbuild-plugin": "^0.16.0",
		"@rsbuild/core": "^1.4.3",
		"@rsbuild/plugin-react": "^1.3.3",
		"@tanstack/router-plugin": "^1.124.0",
		"@types/animejs": "^3.1.13",
		"@types/bun": "^1.2.17",
		"@types/canvas-confetti": "^1.9.0",
		"@types/luxon": "^3.6.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@types/react-virtualized": "^9.22.2",
		"dotenv-cli": "^8.0.0",
		"lefthook": "^1.11.16",
		"typescript": "^5.8.3"
	}
}
